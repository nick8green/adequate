{
  "name": "adequate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "check": "prettier --check . && yarn lint && yarn typecheck && yarn test:ci",
    "checks": "yarn format && yarn lint:fix; yarn test --passWithNoTests",
    "coverage": "open coverage/lcov-report/index.html",
    "format": "prettier --write .",
    "generate:test-matrix": "node scripts/get-jest-projects.cjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --no-cache",
    "lint:check": "yarn lint --max-warnings 0",
    "lint:fix": "yarn lint --fix",
    "release": "lerna publish",
    "test": "jest --coverage --silent",
    "test:debug": "jest --coverage --silent=false",
    "test:watch": "jest --watch",
    "test:app": "yarn test --selectProjects=adequate-app",
    "test:admin": "yarn test --selectProjects=adequate-admin",
    "test:shared": "yarn test --selectProjects=adequate-shared",
    "test:ci": "yarn test --passWithNoTests --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "10.3.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-playwright": "2.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.7.0",
    "identity-obj-proxy": "3.0.0",
    "istanbul-reports": "3.2.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "17.0.0",
    "lcov-parse": "1.0.0",
    "lerna": "9.0.7",
    "prettier": "3.9.1",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0"
  },
  "dependencies": {
    "@nick8green/components": "1.0.0",
    "@opentelemetry/api-logs": "0.217.0",
    "@opentelemetry/instrumentation": "0.217.0",
    "@opentelemetry/sdk-logs": "0.217.0",
    "@testing-library/react": "16.3.2",
    "@vercel/otel": "2.1.2",
    "next": "16.2.6",
    "prom-client": "15.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "type": "module",
  "resolutions": {
    "axios": "1.12.2",
    "tmp": "0.2.4",
    "webpack-dev-server": "5.2.1"
  },
  "packageManager": "yarn@4.14.1"
}
